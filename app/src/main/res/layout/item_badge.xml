<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    app:strokeColor="#E4E8F0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Badge Icon -->

        <TextView
            android:id="@+id/tvBadgeIcon"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_circle"
            android:gravity="center"
            android:text="🏆"
            android:textSize="28sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Badge Name -->

        <TextView
            android:id="@+id/tvBadgeName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:text="Proven Skill"
            android:textColor="#172033"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvBadgeStatus"
            app:layout_constraintStart_toEndOf="@id/tvBadgeIcon"
            app:layout_constraintTop_toTopOf="@id/tvBadgeIcon" />

        <!-- Status -->

        <TextView
            android:id="@+id/tvBadgeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UNLOCKED ✓"
            android:textColor="#172033"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvBadgeName" />

        <!-- Description -->

        <TextView
            android:id="@+id/tvBadgeDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:text="Reach a Proof Score of 75 or higher."
            android:textColor="#737D8F"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@id/tvBadgeIcon"
            app:layout_constraintEnd_toEndOf="@id/tvBadgeStatus"
            app:layout_constraintStart_toStartOf="@id/tvBadgeName"
            app:layout_constraintTop_toBottomOf="@id/tvBadgeName" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>