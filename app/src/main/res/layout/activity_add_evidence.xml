<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC"
    android:fillViewport="true"
    tools:context=".AddEvidenceActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <!-- ===================================== -->
        <!-- Decorative Circle -->
        <!-- ===================================== -->

        <View
            android:id="@+id/topDecoration"
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:background="@drawable/bg_login_circle"
            android:translationX="95dp"
            android:translationY="-100dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ===================================== -->
        <!-- Back Button -->
        <!-- ===================================== -->

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_revert"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ===================================== -->
        <!-- Page Title -->
        <!-- ===================================== -->

        <TextView
            android:id="@+id/tvPageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Add Evidence"
            android:textColor="#172033"
            android:textSize="29sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBack" />

        <!-- ===================================== -->
        <!-- Subtitle -->
        <!-- ===================================== -->

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Add proof that supports one of your skills."
            android:textColor="#737D8F"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPageTitle" />

        <!-- ===================================== -->
        <!-- Evidence Title -->
        <!-- ===================================== -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/evidenceTitleLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Evidence title"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEvidenceTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Example: E-Commerce Project"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingTop="15dp"
                android:paddingBottom="15dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ===================================== -->
        <!-- Related Skill -->
        <!-- ===================================== -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/evidenceSkillLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Related skill"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/evidenceTitleLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEvidenceSkill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Example: Java"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:paddingTop="15dp"
                android:paddingBottom="15dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ===================================== -->
        <!-- Evidence Type -->
        <!-- ===================================== -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/evidenceTypeLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Evidence type"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/evidenceSkillLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEvidenceType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Example: Project, Certificate, Course"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingTop="15dp"
                android:paddingBottom="15dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ===================================== -->
        <!-- Evidence Link -->
        <!-- ===================================== -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/evidenceLinkLayout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="Evidence link"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusTopStart="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/evidenceTypeLayout">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEvidenceLink"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://github.com/..."
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingTop="15dp"
                android:paddingBottom="15dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ===================================== -->
        <!-- Attachment Card -->
        <!-- ===================================== -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/attachmentCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/evidenceLinkLayout"
            app:strokeColor="#E4E8F0"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp">

                <!-- Attachment Title -->

                <TextView
                    android:id="@+id/tvAttachmentTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Attachment"
                    android:textColor="#172033"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Hint -->

                <TextView
                    android:id="@+id/tvAttachmentHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Optional: attach a screenshot, certificate or image."
                    android:textColor="#737D8F"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvAttachmentTitle" />

                <!-- Choose File -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChooseFile"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:text="Choose File"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvAttachmentHint" />

                <!-- Selected File -->

                <TextView
                    android:id="@+id/tvSelectedFile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="middle"
                    android:maxLines="2"
                    android:textColor="#172033"
                    android:textSize="13sp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btnChooseFile" />

                <!-- Image Preview -->

                <ImageView
                    android:id="@+id/ivAttachmentPreview"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_marginTop="12dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Attachment preview"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSelectedFile" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ===================================== -->
        <!-- Save Button -->
        <!-- ===================================== -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveEvidence"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:text="Save Evidence"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/attachmentCard" />

        <!-- ===================================== -->
        <!-- Bottom Hint -->
        <!-- ===================================== -->

        <TextView
            android:id="@+id/tvBottomHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Evidence starts as unverified. You can verify it later."
            android:textColor="#8A93A3"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnSaveEvidence" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>