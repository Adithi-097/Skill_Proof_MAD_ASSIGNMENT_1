<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".DashboardActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- ================================= -->
        <!-- HEADER -->
        <!-- ================================= -->

        <TextView
            android:id="@+id/tvGoodMorning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Good Morning,"
            android:textColor="#737D8F"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/tvProfile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="SkillProof User"
            android:textColor="#172033"
            android:textSize="27sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvProfile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvGoodMorning" />

        <!-- Profile -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tvProfile"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="#E4E8F0"
            app:strokeWidth="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="👤"
                android:textSize="22sp" />

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================= -->
        <!-- PROOF SCORE CARD -->
        <!-- ================================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/proofScoreCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvUserName"
            app:strokeColor="#E4E8F0"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvProofScoreLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="YOUR PROOF SCORE"
                    android:textColor="#737D8F"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvProofScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0"
                    android:textColor="#172033"
                    android:textSize="42sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvProofScoreLabel" />

                <TextView
                    android:id="@+id/tvProofMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Start building your proof."
                    android:textColor="#737D8F"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="@id/tvProofScore"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvProofScore"
                    app:layout_constraintTop_toTopOf="@id/tvProofScore" />

                <ProgressBar
                    android:id="@+id/proofProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="14dp"
                    android:max="100"
                    android:progress="0"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvProofScore" />

                <TextView
                    android:id="@+id/tvProofHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Tip: Add your first skill."
                    android:textColor="#737D8F"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/proofProgress" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================= -->
        <!-- PROGRESS TITLE -->
        <!-- ================================= -->

        <TextView
            android:id="@+id/tvProgressTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:text="Your Skill"
            android:textColor="#172033"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/proofScoreCard" />

        <!-- ================================= -->
        <!-- SKILLS CARD -->
        <!-- ================================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/skillsCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvProgressTitle"
            app:strokeColor="#E4E8F0"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="92dp"
                android:padding="17dp">

                <TextView
                    android:id="@+id/tvSkillsIcon"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_circle"
                    android:gravity="center"
                    android:text="💡"
                    android:textSize="23sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvSkillsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="Skills"
                    android:textColor="#172033"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tvViewSkills"
                    app:layout_constraintStart_toEndOf="@id/tvSkillsIcon"
                    app:layout_constraintTop_toTopOf="@id/tvSkillsIcon" />

                <TextView
                    android:id="@+id/tvSkillsDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="4dp"
                    android:text="Manage your skills and progress"
                    android:textColor="#737D8F"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toStartOf="@id/tvViewSkills"
                    app:layout_constraintStart_toEndOf="@id/tvSkillsIcon"
                    app:layout_constraintTop_toBottomOf="@id/tvSkillsTitle" />

                <TextView
                    android:id="@+id/tvViewSkills"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#172033"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================= -->
        <!-- EVIDENCE CARD -->
        <!-- ================================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/evidenceCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/skillsCard"
            app:strokeColor="#E4E8F0"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="92dp"
                android:padding="17dp">

                <TextView
                    android:id="@+id/tvEvidenceIcon"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_circle"
                    android:gravity="center"
                    android:text="📎"
                    android:textSize="23sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvEvidenceTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="Evidence"
                    android:textColor="#172033"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tvViewEvidence"
                    app:layout_constraintStart_toEndOf="@id/tvEvidenceIcon"
                    app:layout_constraintTop_toTopOf="@id/tvEvidenceIcon" />

                <TextView
                    android:id="@+id/tvEvidenceDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="4dp"
                    android:text="Projects, certificates and proof"
                    android:textColor="#737D8F"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toStartOf="@id/tvViewEvidence"
                    app:layout_constraintStart_toEndOf="@id/tvEvidenceIcon"
                    app:layout_constraintTop_toBottomOf="@id/tvEvidenceTitle" />

                <TextView
                    android:id="@+id/tvViewEvidence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#172033"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================= -->
        <!-- ASSESSMENT CARD -->
        <!-- ================================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/assessmentCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/evidenceCard"
            app:strokeColor="#E4E8F0"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="92dp"
                android:padding="17dp">

                <TextView
                    android:id="@+id/tvAssessmentIcon"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_circle"
                    android:gravity="center"
                    android:text="📝"
                    android:textSize="23sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvAssessmentTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="Assessment"
                    android:textColor="#172033"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tvViewAssessment"
                    app:layout_constraintStart_toEndOf="@id/tvAssessmentIcon"
                    app:layout_constraintTop_toTopOf="@id/tvAssessmentIcon" />

                <TextView
                    android:id="@+id/tvAssessmentDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="4dp"
                    android:text="Test your knowledge and understanding"
                    android:textColor="#737D8F"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toStartOf="@id/tvViewAssessment"
                    app:layout_constraintStart_toEndOf="@id/tvAssessmentIcon"
                    app:layout_constraintTop_toBottomOf="@id/tvAssessmentTitle" />

                <TextView
                    android:id="@+id/tvViewAssessment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#172033"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================= -->
        <!-- CAREER CARD -->
        <!-- ================================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/careerCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/assessmentCard"
            app:strokeColor="#E4E8F0"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="92dp"
                android:padding="17dp">

                <TextView
                    android:id="@+id/tvCareerIcon"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_circle"
                    android:gravity="center"
                    android:text="🚀"
                    android:textSize="23sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvCareerTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="Career Readiness"
                    android:textColor="#172033"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tvViewCareer"
                    app:layout_constraintStart_toEndOf="@id/tvCareerIcon"
                    app:layout_constraintTop_toTopOf="@id/tvCareerIcon" />

                <TextView
                    android:id="@+id/tvCareerDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="4dp"
                    android:text="Check readiness, badges and skill gaps"
                    android:textColor="#737D8F"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toStartOf="@id/tvViewCareer"
                    app:layout_constraintStart_toEndOf="@id/tvCareerIcon"
                    app:layout_constraintTop_toBottomOf="@id/tvCareerTitle" />

                <TextView
                    android:id="@+id/tvViewCareer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#172033"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>