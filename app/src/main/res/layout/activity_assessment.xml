<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_menu_revert"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Skill Assessment"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="center"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Test your knowledge and improve your SkillProof score."
            android:textSize="15sp"
            android:gravity="center"
            android:textColor="?android:attr/textColorSecondary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBack" />

        <!-- Skill Label -->
        <TextView
            android:id="@+id/tvSkillLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Select Skill"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDescription" />

        <!-- Skill Spinner -->
        <Spinner
            android:id="@+id/spinnerSkill"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/btn_dropdown"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSkillLabel" />

        <!-- Question 1 Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuestion1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinnerSkill">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvQuestion1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Question 1"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <RadioGroup
                    android:id="@+id/rgQuestion1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvQuestion1">

                    <RadioButton
                        android:id="@+id/rbQ1Option1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option 1"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbQ1Option2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option 2"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbQ1Option3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option 3"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbQ1Option4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option 4"
                        android:textSize="15sp" />

                </RadioGroup>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Question 2 Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuestion2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardQuestion1">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvQuestion2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Question 2"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <RadioGroup
                    android:id="@+id/rgQuestion2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvQuestion2">

                    <RadioButton
                        android:id="@+id/rbQ2Option1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option 1"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbQ2Option2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option 2"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbQ2Option3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option 3"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbQ2Option4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option 4"
                        android:textSize="15sp" />

                </RadioGroup>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Question 3 Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuestion3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardQuestion2">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvQuestion3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Question 3"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <RadioGroup
                    android:id="@+id/rgQuestion3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvQuestion3">

                    <RadioButton
                        android:id="@+id/rbQ3Option1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option 1"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbQ3Option2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option 2"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbQ3Option3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option 3"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbQ3Option4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option 4"
                        android:textSize="15sp" />

                </RadioGroup>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Question 4 Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuestion4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardQuestion3">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvQuestion4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Question 4"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <RadioGroup
                    android:id="@+id/rgQuestion4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvQuestion4">

                    <RadioButton
                        android:id="@+id/rbQ4Option1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option 1"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbQ4Option2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option 2"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbQ4Option3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option 3"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbQ4Option4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option 4"
                        android:textSize="15sp" />

                </RadioGroup>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Question 5 Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuestion5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardQuestion4">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvQuestion5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Question 5"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <RadioGroup
                    android:id="@+id/rgQuestion5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvQuestion5">

                    <RadioButton
                        android:id="@+id/rbQ5Option1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option 1"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbQ5Option2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option 2"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbQ5Option3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option 3"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/rbQ5Option4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Option 4"
                        android:textSize="15sp" />

                </RadioGroup>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- Submit Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Submit Assessment"
            android:textSize="16sp"
            android:textStyle="bold"
            android:minHeight="52dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardQuestion5" />

        <!-- Bottom Spacing -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp"
            app:layout_constraintTop_toBottomOf="@id/btnSubmit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>