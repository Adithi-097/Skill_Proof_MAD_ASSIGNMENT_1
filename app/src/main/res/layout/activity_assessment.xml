<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FC"
    android:fillViewport="true"
    tools:context=".AssessmentActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <!-- Back Button -->

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_revert"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Page Title -->

        <TextView
            android:id="@+id/tvPageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Skill Assessment"
            android:textColor="#172033"
            android:textSize="29sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBack" />

        <!-- Description -->

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Test your knowledge and strengthen your skill proof."
            android:textColor="#737D8F"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPageTitle" />

        <!-- Skill Selection Card -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/skillSelectionCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDescription"
            app:strokeColor="#E4E8F0"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvSkillLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Select skill"
                    android:textColor="#172033"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <Spinner
                    android:id="@+id/spinnerSkill"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@android:drawable/btn_dropdown"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSkillLabel" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Question 1 -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/questionCard1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/skillSelectionCard">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvQuestion1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="1. Which keyword is used to declare a variable that cannot be reassigned in Kotlin?"
                    android:textColor="#172033"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <RadioGroup
                    android:id="@+id/rgQuestion1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvQuestion1">

                    <RadioButton
                        android:id="@+id/q1Option1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="var" />

                    <RadioButton
                        android:id="@+id/q1Option2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="val" />

                    <RadioButton
                        android:id="@+id/q1Option3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="let" />

                    <RadioButton
                        android:id="@+id/q1Option4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="constant" />

                </RadioGroup>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Question 2 -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/questionCard2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/questionCard1">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvQuestion2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="2. Which data structure follows the FIFO principle?"
                    android:textColor="#172033"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <RadioGroup
                    android:id="@+id/rgQuestion2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvQuestion2">

                    <RadioButton
                        android:id="@+id/q2Option1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Queue" />

                    <RadioButton
                        android:id="@+id/q2Option2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stack" />

                    <RadioButton
                        android:id="@+id/q2Option3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tree" />

                    <RadioButton
                        android:id="@+id/q2Option4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Graph" />

                </RadioGroup>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Question 3 -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/questionCard3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/questionCard2">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvQuestion3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="3. Which SQL command is used to retrieve data from a table?"
                    android:textColor="#172033"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <RadioGroup
                    android:id="@+id/rgQuestion3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvQuestion3">

                    <RadioButton
                        android:id="@+id/q3Option1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INSERT" />

                    <RadioButton
                        android:id="@+id/q3Option2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="UPDATE" />

                    <RadioButton
                        android:id="@+id/q3Option3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SELECT" />

                    <RadioButton
                        android:id="@+id/q3Option4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DELETE" />

                </RadioGroup>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Question 4 -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/questionCard4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/questionCard3">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvQuestion4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="4. Which Android component is commonly used to display a scrollable list?"
                    android:textColor="#172033"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <RadioGroup
                    android:id="@+id/rgQuestion4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvQuestion4">

                    <RadioButton
                        android:id="@+id/q4Option1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ImageView" />

                    <RadioButton
                        android:id="@+id/q4Option2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RecyclerView" />

                    <RadioButton
                        android:id="@+id/q4Option3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TextView" />

                    <RadioButton
                        android:id="@+id/q4Option4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Switch" />

                </RadioGroup>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Question 5 -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/questionCard5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/questionCard4">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvQuestion5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="5. Which HTTP method is normally used to retrieve data from an API?"
                    android:textColor="#172033"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <RadioGroup
                    android:id="@+id/rgQuestion5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_to_startOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvQuestion5">

                    <RadioButton
                        android:id="@+id/q5Option1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GET" />

                    <RadioButton
                        android:id="@+id/q5Option2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="POST" />

                    <RadioButton
                        android:id="@+id/q5Option3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DELETE" />

                    <RadioButton
                        android:id="@+id/q5Option4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PATCH" />

                </RadioGroup>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Submit -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:text="Submit Assessment"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/questionCard5" />

        <!-- Result Title -->

        <TextView
            android:id="@+id/tvResultTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Assessment Result"
            android:textColor="#172033"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnSubmit" />

        <!-- Result Score -->

        <TextView
            android:id="@+id/tvResultScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="4 / 5 • 80%"
            android:textColor="#172033"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvResultTitle" />

        <!-- Result Message -->

        <TextView
            android:id="@+id/tvResultMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Excellent!"
            android:textColor="#737D8F"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvResultScore" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>